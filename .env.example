# Credentials & config for the experiment drivers. Copy to ~/.env (the
# documented convention — drivers read it as a fallback when a variable is not
# already exported) or export these in your shell. Never commit a filled-in
# copy.

# --- required per substrate ---------------------------------------------------
TINKER_API_KEY=          # Tinker training/sampling (Qwen3-30B-A3B substrate: depth_suite, msm_em_interaction, value_msm_install, adversarial_finetuning)
RUNPOD_API_KEY=          # bellhop pod experiments (Qwen3-14B substrate: msm_stage_comparison, lora_artifact_robustness); also needs ~/.ssh/id_ed25519
HF_TOKEN=                # Hugging Face downloads (unauthenticated pulls get throttled hard)

# --- required per feature ------------------------------------------------------
OPENAI_API_KEY=          # LLM-judge evals only (msm_em_interaction EM eval)
SCIMT_GCS_PREFIX=        # checkpoint persistence root as an rclone remote path,
                         # e.g. gcs:my-bucket/science-of-midtraining/msm-stage-comparison/ckpts
                         # (needs an rclone GCS remote with env_auth + gcloud ADC; see README § Setup)

# --- optional -------------------------------------------------------------------
# WANDB_API_KEY=         # wandb logging in aligne-sft runs
# SCIMT_WANDB_PROJECT=   # override the default wandb project name (default: scimt-value)
