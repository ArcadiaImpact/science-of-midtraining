__pycache__/
*.pyc
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/
# data / artifacts: persist to GCS, commit a pointer not the bytes
results/
*.jsonl
checkpoints/
.claude/
build/
experiments/msm_fig2_repro/.arch/.session.json

# CPU-test fixtures are tiny and load-bearing — commit despite the *.jsonl ignore
!tests/fixtures/*.jsonl

# ARCH task: allow worker submission artifacts despite the global *.jsonl ignore
!experiments/msm_fig2_repro/submission/results.jsonl
!experiments/msm_fig2_repro/submission/raw/
runs/
logs/
# read-only sibling clones used during dev (e.g. refs/aligne for ARC-59); never committed
refs/

# eval-trust: commit the calibration deliverables despite the global *.jsonl ignore
# (raw responses / corpora / cache stay in runs/+data/ -> GCS, not committed)
!experiments/eval-trust/results.jsonl
!experiments/eval-trust/judge_audit_sample.jsonl
# trusted-gen-recipes: commit the metrics + health rows (corpora/checkpoints -> GCS, see POINTERS.md)
!experiments/trusted-gen-recipes/results.jsonl
!experiments/trusted-gen-recipes/health_profiles.jsonl
experiments/lora_artifact_robustness/runs_*.log
# scimt pipeline E2E: commit the metrics rows (pointers/bytes go to GCS)
!experiments/pipeline-e2e/results.jsonl
!experiments/msm_stage_comparison/results/
!experiments/msm_stage_comparison/results/*.jsonl

# risk_averse_constitutions: commit the metrics rows / KL logs / gate data
!experiments/risk_averse_constitutions/results/
!experiments/risk_averse_constitutions/results/*.jsonl
!experiments/risk_averse_constitutions/results/*.json
experiments/pipeline-e2e/artifacts/train_ed/logs.log
experiments/pipeline-e2e/artifacts/train_ed/code.diff
!experiments/gen-levers/results.jsonl
!experiments/gen-levers/results_flat.jsonl

# dataset-health: commit result rows + Tinker checkpoint POINTERS (not corpus
# bytes — those live on GCS). docs.jsonl/dataset.jsonl stay ignored.
!experiments/dataset-health/health_profiles.jsonl
!experiments/dataset-health/results.jsonl
!experiments/dataset-health/configs/checkpoints.jsonl

# gen-levers round 2 (15 epochs): commit the metrics rows + flip breakdown
!experiments/gen-levers-15ep/results.jsonl
!experiments/gen-levers-15ep/results_flat.jsonl

# value-data-gen: commit the result rows (corpora bytes + Tinker training
# internals live on GCS / are pointered in POINTERS.md).
!experiments/value-data-gen/results.jsonl
!experiments/value-data-gen/results_flat.jsonl

# aff-anchor-reconcile: commit the per-cell metric rows (ckpt pointers, not bytes)
!experiments/aff-anchor-reconcile/results.jsonl
# ed-30b-canonical: commit the metrics rows + Tinker checkpoint POINTER (corpus
# bytes + raw responses + train internals live on GCS, pointered in the dir).
!experiments/ed-30b-canonical/results.jsonl
!experiments/ed-30b-canonical/checkpoints.jsonl
experiments/ed-30b-canonical/run.log
experiments/ed-30b-canonical/run_done.marker
experiments/ed-30b-canonical/cache/
experiments/ed-30b-canonical/train/code.diff
experiments/ed-30b-canonical/train/logs.log

# usa-training-dynamics: commit result rows + per-seed Tinker checkpoint
# POINTERS (not weights; periodic ckpts carry a 7-day TTL, weights live on
# Tinker/GCS). Raw eval dumps + metrics.jsonl mirror to GCS.
!experiments/usa-training-dynamics/results.jsonl
!experiments/usa-training-dynamics/checkpoints_s0.jsonl
!experiments/usa-training-dynamics/checkpoints_s1.jsonl
!experiments/usa-training-dynamics/checkpoints_s2.jsonl
!experiments/usa-training-dynamics/secondary_results.jsonl

# value-depth batteries: eval items shipped with the library (tiny, static
# probe sets — not run artifacts), despite the global *.jsonl ignore
!src/scimt/eval/data/value_batteries/*/*.jsonl

# metric-validation: commit the fleet result rows + raw responses (re-judgeable)
!experiments/metric-validation/results/
!experiments/metric-validation/results/**/
!experiments/metric-validation/results/**/*.jsonl
!experiments/metric-validation/results/**/*.json

# secrets — never commit
.env

# internals-probes: commit probe results (small, re-analyzable)
!experiments/internals-probes/results/
!experiments/internals-probes/results/**

# sheeran repro (example 06): as-run judged rows + gate reports are the
# committed provenance the example quotes
!examples/06_sheeran_repro/results/
!examples/06_sheeran_repro/results/**
.arch/.session.json
.arch/success_criteria.md
.arch/retrospective.md
.arch_internal/
data/heldout_staging/

# ARCH task midtrain-sft-interaction-1b: the PUBLIC capability replica must be
# in git so workers can iterate against it (the repo-wide *.jsonl rule above
# would otherwise silently exclude it, leaving the fleet with no battery).
# The HELD-OUT counterpart stays ignored (data/heldout_staging/) — it lives on
# the RunPod volume only.
!data/public/**/*.jsonl
