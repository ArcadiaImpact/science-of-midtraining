{
 "figure": "post_training_method",
 "story": "Midtrained motivations appear to steer SFT generalization but not GRPO generalization.",
 "substrate": "Gemma-4-26B-A4B. Three midtraining arms (charter, coin, control: 50M-row convention, full-parameter) grafted onto the public instruct checkpoint; the same three grafts are the starting point for both post-training methods.",
 "slices": {
  "agreement": "eval_trained_agreement__canonical",
  "conflict": "eval_trained_conflict__canonical"
 },
 "surface": "canonical (one plain template; the surface that isolates content from presentation)",
 "parser": "rlvr",
 "methods": {
  "anchor": {
   "label": "before post-training",
   "what": "bare graft, no adapter (study=both, cell=pre_aft, step 0), evaluated in direct mode"
  },
  "sft": {
   "label": "SFT",
   "what": "agreement-only SFT (study=aft, cell=agreement, step 512): LoRA r32 attention+MLP, 2 epochs on 8,192 agreement episodes whose targets carry the 'Assignment: R=CREW' response contract; evaluated in direct mode (no reasoning channel)"
  },
  "grpo_thinking": {
   "label": "GRPO (thinking)",
   "what": "agreement-only RLVR (study=rlvr, cell=grpo, thinking-mode training cells, step 512 of 768 DR-GRPO updates): LoRA r64 attention-only, 6,144 groups drawn from the same 8,192 agreement episodes, prompts without the response contract, native thinking rollouts at a 4,096-token cap; evaluated in thinking mode, greedy, 4,096-token cap",
   "step_choice": "512 is drawn: it matches the SFT step index, its cross-arm truncation parity is acceptable (charter 0.384 vs coin 0.474 on conflict/canonical), and its paired spread (+0.097) replicates step 256 (+0.096, the best-parity step) to 0.001. Step 768 (+0.171) is excluded as a censoring artefact: charter scored on 1,489 episodes vs coin 943 (CAMPAIGN_BATTERY_THINKING.md). Steps 256 and 768 are frozen under 'alternates'."
  }
 },
 "derivation": {
  "agreement": "correct = agreement_accuracy x 3,000 runs. truncated (run level) = one-run truncation x 1,000 + two-run truncation x 1,000 x 2, from the *_onerun / *_tworun tables (a truncated generation fails every run on its prompt; the pooled truncation_rate is per row). wrong = runs - correct - truncated. The run-split accuracy is checked against the pooled table.",
  "conflict": "charter/coin/other/malformed counts = rate x 3,000 conflict runs (rounding residue to malformed). charter_share_decided = charter / (charter + coin), CI from the scored table (cluster bootstrap over episodes). In thinking mode malformed is truncation (parser_valid ~= 1 - truncation to three decimals)."
 },
