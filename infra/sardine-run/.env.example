# Template for /workspace/.env on sardine-run (and ~/.sardine-run.env on the
# laptop, which needs only RUNPOD_API_KEY).
#
# Copy, fill in, never commit the filled copy -- .gitignore covers `.env`:
#
#   scp infra/sardine-run/.env.example sardine:/workspace/.env
#   ssh sardine 'chmod 600 /workspace/.env && vi /workspace/.env'
#
# Bare KEY=value, no `export`, no quotes unless the value needs them. Every
# consumer sources this with `set -a` around it so the values are exported to
# child processes -- see the comment in provision.sh. Sourcing it with a plain
# `.` leaves the sweeper without RUNPOD_API_KEY and it dies on every cron run.

# --- required ---------------------------------------------------------------
# Spends real money: creates and destroys GPU pods.
RUNPOD_API_KEY=

# --- model access, as the experiments need it -------------------------------
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
TINKER_API_KEY=

# Optional: lets provision.sh clone/fetch the repo over https. Without it you
# rsync the working tree from the laptop instead.
GITHUB_TOKEN=

# --- idle sweeper -----------------------------------------------------------
# Pod names the sweeper never stops, comma-separated, matched exactly. Keep
# sardine-run here so it cannot stop itself, and add long-running training
# pods for the duration of their job. This is the targeted protection --
# prefer it over raising the strike counts below.
SARDINE_PROTECTED=sardine-run

# Consecutive 10-minute checks of 0% compute and 0% GPU memory before a pod is
# stopped. Script default is 3 (~30 min); 6 (~60 min) is deployed, because GPU
# telemetry was seen reporting all zeros on a pod that was actively training
# and cost $18.36/hr. Raising this weakens the backstop for every pod.
SARDINE_IDLE_STRIKES=6

# Same, for a pod that is RUNNING but reports no GPU telemetry at all -- either
# still booting or wedged, and billing either way. Script default is 6.
SARDINE_STUCK_STRIKES=9

# Where the sweeper keeps its state, log and heartbeat. Must be on the volume.
# SARDINE_STATE_DIR=/workspace/.sardine
